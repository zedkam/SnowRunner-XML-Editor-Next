{
	"name": "snowrunner-xml-editor-desktop",
	"productName": "SnowRunner XML Editor Next",
	"version": "2.0.0-beta.2",
	"description": "Allows you to visually edit the game's XML files.",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/zedkam/SnowRunner-XML-Editor-Next.git"
	},
	"main": ".vite/build/index.js",
	"scripts": {
	"package": "node tools/release/package.mjs",
		"package:portable:raw": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:SNOWRUNNER_SKIP_RELEASE_ARTIFACTS='1'; npm.cmd run package\"",
		"package:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/release/build-portable.ps1",
	"package-prod": "npm i && cross-env NODE_ENV=production node tools/release/package.mjs",
		"start": "cross-env NODE_ENV=development electron-forge start",
		"lint": "eslint src/**",
		"lint:fix": "npm run lint -- --fix",
		"check": "tsc --project src/tsconfig.json --noEmit && vue-tsc --project src/tsconfig.json --noEmit",
		"diagnose": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/diagnostics/check-dlc-readiness.ps1",
		"generate:content": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/generation/generate-content.ps1",
		"generate:images": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/generation/generate-game-images.ps1",
		"test:roundtrip": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/generation/roundtrip-test.ps1"
	},
	"keywords": [],
	"author": {
		"name": "VerZsuT",
		"email": "verzsut@gmail.com"
	},
	"license": "MIT",
	"config": {
		"forge": "./src/build-configs/forge.js"
	},
	"devDependencies": {
		"@ant-design/icons-vue": "^7.0.1",
		"@electron-forge/cli": "^7.8.0",
		"@electron-forge/plugin-vite": "^7.8.0",
		"@eslint/js": "^9.25.0",
		"@types/memoizee": "^0.4.12",
		"@typescript-eslint/eslint-plugin": "^8.30.1",
		"@typescript-eslint/parser": "^8.30.1",
		"@vitejs/plugin-vue": "^5.2.3",
		"ant-design-vue": "^4.2.6",
		"cheerio": "^1.0.0",
		"cross-env": "^7.0.3",
		"debounce": "^2.2.0",
		"electron": "^35.2.0",
		"emr-bridge": "^2.0.2",
		"eslint": "^9.25.0",
		"eslint-import-resolver-typescript": "^4.3.3",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-unicorn": "^58.0.0",
		"eslint-plugin-vue": "^10.0.0",
		"memoizee": "^0.4.17",
		"pinia": "^3.0.2",
		"sass": "^1.86.3",
		"ts-node": "^10.9.2",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.30.1",
		"vite": "^6.3.2",
		"vite-plugin-static-copy": "^2.3.1",
		"vue": "^3.5.13",
		"vue-eslint-parser": "^10.1.3",
		"vue-tsc": "^2.2.8",
		"xml-formatter": "^3.6.5"
	}
}
