{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.snowrunnerxml.invalid/schemas/orchestration-task-state-v1.json",
  "title": "SnowrunnerXML orchestration task state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "title",
    "objective",
    "status",
    "phase",
    "revision",
    "created_at",
    "updated_at",
    "scope_paths",
    "authority",
    "accepted_work",
    "context",
    "model_routes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$", "maxLength": 64 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "objective": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "status": { "enum": ["active", "blocked", "complete", "archived"] },
    "phase": { "enum": ["intake", "research", "design", "implementation", "validation", "handoff"] },
    "revision": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "scope_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 500 },
      "uniqueItems": true
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraints", "open_questions"],
      "properties": {
        "constraints": { "$ref": "#/$defs/shortStringArray" },
        "open_questions": { "$ref": "#/$defs/shortStringArray" }
      }
    },
    "accepted_work": {
      "type": ["object", "null"]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_summary", "decisions", "completed", "next_actions", "files", "evidence"],
      "properties": {
        "current_summary": { "type": "string", "maxLength": 4000 },
        "decisions": { "$ref": "#/$defs/shortStringArray" },
        "completed": { "$ref": "#/$defs/shortStringArray" },
        "next_actions": { "$ref": "#/$defs/shortStringArray" },
        "files": { "$ref": "#/$defs/shortStringArray" },
        "evidence": { "$ref": "#/$defs/shortStringArray" }
      }
    },
    "model_routes": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "$defs": {
    "shortStringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 },
      "maxItems": 200
    }
  }
}
